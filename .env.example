ANTHROPIC_API_KEY=
# OPENAI_API_KEY=              # pip install -e ".[openai]" — for openai:* models and embeddings

RAG_CHAT_MODEL=anthropic:claude-sonnet-5-5
RAG_FAST_MODEL=anthropic:claude-haiku-5-5

# Embeddings: local ONNX via FastEmbed (multilingual — suitable for UA/RU documents)
RAG_EMBEDDINGS=fastembed:sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RAG_EMBEDDINGS=fastembed:intfloat/multilingual-e5-large      # higher quality, 2.2 GB
# RAG_EMBEDDINGS=openai:text-embedding-3-large
RAG_SPARSE_EMBEDDINGS=fastembed:Qdrant/bm25                    # none → dense only
RAG_RERANKER=fastembed:jinaai/jina-reranker-v2-base-multilingual   # none → no reranking

# Qdrant: without a URL — embedded mode (files in .qdrant/, single process);
# with a URL — server (docker compose up qdrant)
# RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_PATH=.qdrant
RAG_COLLECTION=docs

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_FETCH_K=20
RAG_TOP_K=5
RAG_GRADE_DOCUMENTS=true
RAG_MAX_QUERY_REWRITES=1

# Fully offline retrieval demo (no model downloads): lexical stubs
# RAG_EMBEDDINGS=hashing:1024
# RAG_SPARSE_EMBEDDINGS=hashing
# RAG_RERANKER=none

# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
